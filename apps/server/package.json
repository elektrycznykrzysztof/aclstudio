{
  "name": "@acl-manager/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --external ssh2 --outdir=dist",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:deploy": "bunx --bun prisma migrate deploy"
  },
  "dependencies": {
    "@elysia/static": "^1.3.0",
    "@prisma/client": "^6.19.0",
    "elysia": "^1.3.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.13.0",
    "@types/ssh2": "^1.15.5",
    "prisma": "^6.19.0"
  }
}
